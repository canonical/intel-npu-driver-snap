#!/bin/bash

if [[ $EUID -ne 0 ]]; then
    echo "Warning: NPU data may be limited without sudo; sudo cannot bypass snap confinement." >&2
fi

if ! snapctl is-connected hardware-observe; then
    echo "Warning: hardware-observe is not connected; intel-npu-smi cannot initialize PMT telemetry." >&2
    echo "Connect it with: sudo snap connect intel-npu-driver:hardware-observe :hardware-observe" >&2
fi

exec 3>&1
intel-npu-smi "$@" 2>&1 1>&3 | grep --line-buffered -Ev "^Warning: Failed to open directory '/proc/[0-9]+/fd'$" >&2
exit "${PIPESTATUS[0]}"
